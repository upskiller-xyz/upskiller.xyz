# Deploy config for build.sh (gcloud builds submit).
# Copy to .env (gitignored) and adjust. Values here are used unless already
# exported in your shell, which take precedence.

PROJECT_ID=xxx
SERVICE=xxx
REGION=xxx
REPOSITORY=xxx

# Optional — baked into the JS bundle at build time (see Dockerfile / upskiller/.env.example).
# Leave unset to keep the Scaleway bucket default.
VITE_ASSET_BASE_URL=
